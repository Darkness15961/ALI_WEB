---
import { Image } from 'astro:assets';
import hero from '../assets/images/hero-aula.png';
---

<section id="hero" class="relative bg-void pt-28 md:pt-32">
	<div id="contenido" class="mx-auto max-w-5xl px-5 text-center md:px-8">
		<h1
			class="reveal text-[44px] leading-[0.95] font-semibold tracking-[-0.04em] text-paper sm:text-[68px] lg:text-[88px]"
		>
			Hacer visible el<br />bienestar del aula
		</h1>
		<p class="reveal reveal-d1 mx-auto mt-6 max-w-[44ch] text-[16px] leading-7 text-mist md:text-[18px]">
			Trabajamos con docentes y psicólogos para leer el pulso emocional del aula: reconocimiento,
			autorreportes y contexto, juntos en un solo sistema.
		</p>
		<div class="reveal reveal-d2 mt-8 flex flex-wrap items-center justify-center gap-3">
			<a href="#propuesta" class="btn btn-fill">Conocer ALI</a>
			<a href="#investigacion" class="btn btn-ghost">Ver la investigación</a>
		</div>
		<div class="reveal reveal-d3 mt-8 flex flex-wrap items-center justify-center gap-2">
			{
				['Aula', 'Investigación', 'Bienestar', 'Springer'].map((item) => (
					<span class="rounded-full border border-line px-3.5 py-1.5 text-[13px] text-mist">{item}</span>
				))
			}
		</div>
	</div>

	<div class="reveal reveal-d4 mx-auto mt-12 max-w-6xl px-5 pb-4 md:mt-16 md:px-8">
		<div class="frame relative aspect-[16/9] min-h-[280px] md:min-h-[520px]">
			<Image
				src={hero}
				alt="Aula de un colegio, vista desde el fondo, con estudiantes sentados y un docente al frente."
				class="absolute inset-0 h-full w-full object-cover"
				widths={[960, 1440, 1920, 2560]}
				sizes="100vw"
				priority
			/>
			<div
				class="absolute right-4 bottom-4 hidden w-[220px] rounded-2xl border border-white/15 bg-black/55 p-4 backdrop-blur-md sm:block md:right-6 md:bottom-6"
			>
				<p class="text-[11px] text-mist">2° Secundaria A</p>
				<p class="mt-2 text-[13px] font-medium">Estado emocional del aula</p>
				<div class="mt-3 space-y-2">
					<div class="h-1 rounded-full bg-white/10"><div class="h-1 w-[51%] rounded-full bg-white"></div></div>
					<div class="h-1 rounded-full bg-white/10"><div class="h-1 w-[23%] rounded-full bg-white/50"></div></div>
					<div class="h-1 rounded-full bg-white/10"><div class="h-1 w-[17%] rounded-full bg-white/30"></div></div>
				</div>
			</div>
		</div>
	</div>
</section>
