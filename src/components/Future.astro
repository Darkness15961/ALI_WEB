---
const stages = [
	{ k: 'Hoy', t: 'Reconocimiento emocional', d: 'Ayudamos a ver el aula con detección, autorreporte y contexto.' },
	{ k: 'Próximo', t: 'Lectura a lo largo del año', d: 'Estudios longitudinales para acompañar el bienestar en el tiempo.' },
	{ k: 'Futuro', t: 'Más contextos, más cercanía', d: 'Adaptación cultural y neurodivergente, con algoritmos más justos.' },
];
---

<section id="futuro" class="bg-void py-24 md:py-32">
	<div class="mx-auto max-w-4xl px-5 text-center md:px-8">
		<h2 class="reveal text-[36px] leading-[1.05] font-semibold tracking-[-0.03em] sm:text-[52px]">
			Seguimos trabajando hacia un mejor acompañamiento
		</h2>
		<p class="reveal reveal-d1 mx-auto mt-5 max-w-[48ch] text-[16px] leading-7 text-mist">
			Estudios longitudinales, más contextos culturales y un sistema cada vez más cercano a cada
			estudiante y a cada equipo.
		</p>
	</div>
	<ol class="mx-auto mt-16 grid max-w-6xl gap-3 px-5 md:grid-cols-3 md:px-8">
		{
			stages.map((s) => (
				<li class="reveal rounded-[1.5rem] border border-line bg-ink p-7 md:p-8">
					<p class="text-[13px] text-mist">{s.k}</p>
					<h3 class="mt-4 text-[22px] font-semibold tracking-tight">{s.t}</h3>
					<p class="mt-3 text-[14px] leading-6 text-mist">{s.d}</p>
				</li>
			))
		}
	</ol>
</section>
