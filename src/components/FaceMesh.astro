---
interface Props {
	class?: string;
	size?: number;
}

const { class: className = '', size = 280 } = Astro.props;
---

<svg
	class:list={[className]}
	width={size}
	height={size}
	viewBox="0 0 200 240"
	fill="none"
	aria-hidden="true"
>
	<ellipse cx="100" cy="118" rx="62" ry="78" stroke="currentColor" stroke-opacity="0.18" />
	<path
		class="mesh-line"
		d="M58 92 C70 70, 130 70, 142 92 C150 112, 148 150, 132 178 C118 198, 82 198, 68 178 C52 150, 50 112, 58 92Z"
		stroke="currentColor"
		stroke-opacity="0.35"
		stroke-width="0.8"
	/>
	<path d="M78 108 C88 116, 112 116, 122 108" stroke="#4D8BFF" stroke-opacity="0.7" stroke-width="0.9" />
	<path d="M86 156 C96 166, 104 166, 114 156" stroke="#8B6CFF" stroke-opacity="0.65" stroke-width="0.9" />
	<g fill="#4D8BFF">
		<circle class="mesh-point" cx="70" cy="96" r="1.7" style="animation-delay: 0s" />
		<circle class="mesh-point" cx="88" cy="86" r="1.5" style="animation-delay: .2s" />
		<circle class="mesh-point" cx="112" cy="86" r="1.5" style="animation-delay: .35s" />
		<circle class="mesh-point" cx="130" cy="96" r="1.7" style="animation-delay: .1s" />
		<circle class="mesh-point" cx="78" cy="112" r="1.8" fill="#3EE6D6" />
		<circle class="mesh-point" cx="122" cy="112" r="1.8" fill="#3EE6D6" />
		<circle class="mesh-point" cx="100" cy="128" r="1.4" fill="#8B6CFF" />
		<circle class="mesh-point" cx="86" cy="152" r="1.5" />
		<circle class="mesh-point" cx="114" cy="152" r="1.5" />
		<circle class="mesh-point" cx="100" cy="168" r="1.6" fill="#3EE6D6" />
		<circle class="mesh-point" cx="64" cy="132" r="1.3" />
		<circle class="mesh-point" cx="136" cy="132" r="1.3" />
	</g>
	<g stroke="#4D8BFF" stroke-opacity="0.28" stroke-width="0.6">
		<line x1="70" y1="96" x2="78" y2="112" />
		<line x1="130" y1="96" x2="122" y2="112" />
		<line x1="78" y1="112" x2="100" y2="128" />
		<line x1="122" y1="112" x2="100" y2="128" />
		<line x1="100" y1="128" x2="86" y2="152" />
		<line x1="100" y1="128" x2="114" y2="152" />
		<line x1="86" y1="152" x2="100" y2="168" />
		<line x1="114" y1="152" x2="100" y2="168" />
	</g>
</svg>
